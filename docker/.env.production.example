# ==========================================
# CONFIGURATION DE PRODUCTION
# ==========================================
# Copier ce fichier en .env.production et modifier les valeurs

# Base de données PostgreSQL
POSTGRES_USER=l2a_user
POSTGRES_PASSWORD=ChangeMeToASecureRandomPassword123!
POSTGRES_DB=l2a_production
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Flask
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=ChangeMeToAVeryLongRandomSecretKey123456789!

# Port d'accès externe (Raspberry Pi)
APP_PORT=15256

# URLs WebSocket et Backend
# Pour la production, l'URL sera remplacée automatiquement par l'IP du Raspberry Pi
# Exemple: http://192.168.1.100:15256
VITE_BACKEND_URL=http://localhost:15256/api
VITE_WS_URL=ws://localhost:15256/ws
